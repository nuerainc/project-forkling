    {
      "name": "exp009b-highT",
      "type": "run",
      "marker": "results/exp009_seed20261106_temp1.0.json",
      "ckpt": "results/exp009_seed20261106_temp1.0.ckpt.jsonl",
      "log": "results/exp009b-highT.log",
      "heartbeat": "results/exp009b-highT.heartbeat",
