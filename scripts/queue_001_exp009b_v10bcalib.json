      "cmd": [
        "python", "-m", "forkling", "experiment", "run",
        "--protocol", "2",
        "--bench", "bench/FORKLAND-BENCH-002.jsonl",
        "--arms", "N,P,I,R",
        "--k", "10",
        "--replicates", "5",
        "--temperature", "1.0",
        "--seed", "20261106",
        "--model", "qwen2.5-coder:3b",
        "--ollama-url", "http://127.0.0.1:11434",
        "--out", "results/exp009_seed20261106_temp1.0.json",
